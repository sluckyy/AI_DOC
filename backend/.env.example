# Copy to backend/.env for local runs. Everything runs on fakes with no keys.
DATABASE_URL=sqlite:///./aidoc.sqlite
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CONTENT_DIR=../content
PARAMETERS_DEPLOYMENT=sa_health_regional

MODEL_PROVIDER=fake                 # fake | azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT_PERSONA=
AZURE_OPENAI_API_VERSION=2024-10-21

TTS_PROVIDER=fake                   # fake | azure_rest
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=australiaeast
AZURE_SPEECH_VOICE=                 # chosen after the audition (D-08)
AZURE_SPEECH_VOICES=                # optional per-language: en=<voice>,vi=<voice>,it=<voice>,fr=<voice>,ms=<voice>,hi=<voice>

CONTENT_SAFETY_PROVIDER=fake        # fake | azure
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=

TERMINOLOGY_PROVIDER=fake           # fake | fhir
TERMINOLOGY_FHIR_BASE=
TERMINOLOGY_FHIR_TOKEN=
